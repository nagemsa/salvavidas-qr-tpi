{
  "name": "salvavidas-qr-tpi",
  "version": "1.0.0",
  "description": "Sistema Monolítico Modular (DDD + Clean Code) de Identificación Médica de Emergencia mediante QR para Conductores - Taller de Procesos Interdisciplinarios (TPI)",
  "type": "module",
  "scripts": {
    "start": "node --no-warnings src/main.ts",
